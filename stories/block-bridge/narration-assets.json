    {
      "id": "reader-01",
      "mode": "reader",
      "file": "reader-01.mp3",
      "seconds": 26.705057,
      "cues": [
        {
          "start": 0,
          "end": 7.035646258503402,
          "text": "雨天的下午，兄弟倆在客廳鋪好地墊，想用積木蓋一座讓小車通過的橋。"
        },
        {
          "start": 7.385646258503401,
          "end": 13.815646258503401,
          "text": "弟弟放上最後一塊積木，小橋卻倒了。哥哥皺起眉頭，把手縮回來。"
        },
        {
          "start": 14.1656462585034,
          "end": 20.07281179138322,
          "text": "他花了好久才蓋好的橋，一下就散開了。「我不想玩了！」他說。"
        },
        {
          "start": 20.422811791383218,
          "end": 26.3550566893424,
          "text": "媽媽坐到旁邊，輕聲問：「你很失望，對嗎？」哥哥點點頭。"
        }
      ],
      "sha256": "4178ae578f9f55ae619056675a1c16546c8afbb6c92f11a50ac79bc98b67d252"
    },
    {
      "id": "reader-02",
      "mode": "reader",
      "file": "reader-02.mp3",
      "seconds": 29.643311,
      "cues": [
        {
          "start": 0,
          "end": 7.512925170068027,
          "text": "媽媽陪他把手放在腿上，慢慢吸氣、吐氣。積木還在地上，可以等一下再整理。"
        },
        {
          "start": 7.862925170068027,
          "end": 14.445691609977324,
          "text": "等心情平靜一些，哥哥說：「我需要有人扶著橋，讓我把積木放好。」"
        },
        {
          "start": 14.795691609977325,
          "end": 21.548049886621317,
          "text": "弟弟也說：「我不知道要放哪裡，可以先告訴我嗎？」哥哥這才明白，弟弟也需要幫忙。"
        },
        {
          "start": 21.898049886621315,
          "end": 29.293310657596372,
          "text": "他們一起看看倒下的積木，發現下面太窄，決定把底部放寬，再分工試一次。"
        }
      ],
      "sha256": "5aa3f2ad18132977898fdf510242b5f706a2672523eb14e3e1f3a03dc5fbe5a0"
    },
    {
      "id": "reader-03",
      "mode": "reader",
      "file": "reader-03.mp3",
      "seconds": 15.599161,
      "cues": [
        {
          "start": 0,
          "end": 6.809931972789116,
          "text": "弟弟扶住橋，哥哥放上積木。這回，小車順利開過去了，兩個人都笑了。"
        },
        {
          "start": 7.159931972789115,
          "end": 15.249160997732426,
          "text": "哥哥知道，下次不一定馬上成功。但他可以先停一下，說出需要，再和家人一起找辦法。"
        }
      ],
      "sha256": "56ec94a1dea6ea86cefbcfd0b356dbd893467188e5191aa5636483f4f328f447"
    }
  ]
