      "cues": [
        {
          "start": 0,
          "end": 3.030204081632653,
          "text": "十多年後，孩子成為一位律師。"
        },
        {
          "start": 3.380204081632653,
          "end": 5.922789115646259,
          "text": "他的名字叫喬治．漢彌爾頓。"
        },
        {
          "start": 6.272789115646258,
          "end": 10.085328798185941,
          "text": "他說：「我從不強辯，只說出事實真相。」"
        },
        {
          "start": 10.43532879818594,
          "end": 13.268163265306121,
          "text": "「因為神知道我所說的每句話。」"
        }
